NODE_ENV=development
PORT=48787

# Local dev without Clerk: paste this exact string as "Bearer" in the web UI + KSP plugin.
# Must be at least 20 characters. Do not set in production.
DEV_BEARER_SECRET=local-dev-only-change-me-please
# Required since the audit flipped DEV_OPEN_AUTH to default off. Lets the voice bridge
# reach /v1/session/.../livekit-token using only the x-ksc-voice-identity header.
# env.ts refuses to boot if this is set when NODE_ENV=production.
DEV_OPEN_AUTH=1
DEV_USER_ID=dev_local
DEV_USER_ROLE=tower
# Lets the built-in tower@ksc.local / tower12345 login work when
# WEB_LOGIN_USERS_JSON is not set. env.ts refuses to boot if this is set
# in production. Without it, /v1/auth/login returns 401 for every attempt
# because the user list is empty.
# NOTE: Inert while WEB_LOGIN_USERS_JSON below is set — the JSON list
# overrides the built-in default. Left at 1 as a fallback if you blank
# out WEB_LOGIN_USERS_JSON.
DEV_DEFAULT_WEB_USER=1

# Three test accounts so we can exercise every role tier from the web UI
# without juggling Clerk. Must be valid single-line JSON. Each entry needs
# an explicit role — webAuth.ts REJECTS entries with missing/invalid role
# rather than silently defaulting them to pilot.
#   admin@ksc.local       / admin12345        -> owner   (pairs with OWNER_USER_ID below)
#   controller@ksc.local  / controller12345   -> controller
#   pilot@ksc.local       / pilot12345        -> pilot
WEB_LOGIN_USERS_JSON=[{"userId":"admin_local","email":"admin@ksc.local","passwordHash":"$argon2id$v=19$m=65536,t=3,p=4$39Aun6nV13w1Vruq8/Uq2w$DJkLtqS59r3ZQAiCcKi5s0ZDd+LQQdTpf0TfvBE7rdI","role":"owner"},{"userId":"controller_local","email":"controller@ksc.local","passwordHash":"$argon2id$v=19$m=65536,t=3,p=4$6K/rEvJp4PTrIPdi9o7nZA$Xq21kRDG5VsnX6UuwZ24Ab0N47mWn3Xu51Are2fFarA","role":"controller"},{"userId":"pilot_local","email":"pilot@ksc.local","passwordHash":"$argon2id$v=19$m=65536,t=3,p=4$FDa13X558HeDnyDX5yyj4g$6tw42Eusu6CXhFnWTZB8iSC/wl6y6qI7mC6UT/CPrVA","role":"pilot"}]
# Force in-memory persistence in dev. Belt-and-suspenders: lib/db.ts already
# auto-detects MariaDB being down via pingDb(), but setting this explicitly
# means a transient ECONNREFUSED at startup can't ever leave the runtime
# trying to talk to a pool that isn't there.
DEV_IN_MEMORY=1

# Clerk (optional if DEV_BEARER_SECRET is set — leave both unset for dev-only)
# CLERK_SECRET_KEY=sk_test_xxx
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# Admin web UI: include DEV_USER_ID here if you use dev auth
ADMIN_USER_IDS=dev_local
# Owner immunity: this user id always resolves to the `owner` role and bypasses
# bans/role checks. Pinned to the admin account in WEB_LOGIN_USERS_JSON so
# admin@ksc.local can never accidentally lock itself out while testing
# ban/mute/role-change endpoints. Do not set in production.
OWNER_USER_ID=admin_local

# MariaDB
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=changeme
MARIADB_DATABASE=ksc_tower

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Internal app JWT for plugin/session exchange
APP_JWT_SECRET=change-me-to-a-long-random-secret
APP_JWT_EXPIRES_IN_SECONDS=604800

# LiveKit — put YOUR keys in local .env.development (gitignored), not here.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Browser WebSocket URL — must be your real host (e.g. wss://myproj.livekit.cloud).
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
# Optional: Cloud UI sometimes labels this LIVEKIT_URL only — backend uses it if LIVEKIT_WS_URL is missing or contains example.com
# LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit identities that are the Node KSP voice-bridge (not humans).
LIVEKIT_BRIDGE_IDENTITIES=ksp_bridge
LIVEKIT_BRIDGE_DISPLAY_NAME=Kerbal Space Program (voice bridge)

# Telemetry cadence
TELEMETRY_DEFAULT_SECONDS=5
TELEMETRY_CLOSE_SECONDS=1
TELEMETRY_CLOSE_AGL_M=15000
# Soft-close tower rooms when no telemetry for this long (seconds). 0 = off.
PILOT_IDLE_CLOSE_SECONDS=120
# How often to run the idle check (seconds, 5–600).
PILOT_IDLE_SWEEP_INTERVAL_SECONDS=30

DEV_VOICE_IDENTITY_HEADER=x-ksc-voice-identity

# --- Production deployment knobs ---
# These are unset/permissive in dev. For a real public deployment, set them.
#
# Comma-separated list of origins permitted by CORS. Leave empty in dev (backend
# auto-allows common Vite dev origins). In production set to your web hostname:
#   CORS_ORIGINS=https://tower.example.com,https://www.tower.example.com
# Use "*" only if you intentionally want an open API (disables credentialed CORS).
# CORS_ORIGINS=https://tower.example.com

# Optional: explicit owner user id. Persists past DB writes; cannot be banned/demoted.
# OWNER_USER_ID=clerk_user_xxx_or_dev_id

# --- Public landing page / self-serve signup ---
# Surfaced via GET /v1/site/info and consumed by the React landing page.
#
# Signup gate. One of: closed | open | invite_only | open_or_invite
#   closed         (default) — no signup; only WEB_LOGIN_USERS_JSON accounts.
#   open           — anyone can register with email + password as REGISTRATION_DEFAULT_ROLE.
#   invite_only    — registration requires a code from /v1/admin/invite-codes.
#   open_or_invite — both work. Codes can still pin a higher role.
# REGISTRATION_MODE=closed
# REGISTRATION_DEFAULT_ROLE=pilot
# REGISTERED_USERS_PATH=./data/registered-users.json
# INVITE_CODES_PATH=./data/invite-codes.json

# Project branding shown on the landing page.
# PROJECT_DISPLAY_NAME=KSC Tower Network
# PROJECT_TAGLINE=Real human ATC for Kerbal Space Program...

# Plugin distribution. CKAN identifier renders the standard install snippet on
# the landing page. PLUGIN_DOWNLOAD_URL is the manual fallback (usually GitHub
# Releases). At least one of the two should be set so the "Get the plugin"
# section has something to link to.
# PLUGIN_CKAN_IDENTIFIER=KSCTowerNetwork
# PLUGIN_DOWNLOAD_URL=https://github.com/REPLACE_ME_OWNER/KSCTowerNetwork/releases/latest

# Optional community links shown in the landing-page footer.
# PROJECT_REPO_URL=https://github.com/REPLACE_ME_OWNER/KSCTowerNetwork
# PROJECT_DISCORD_URL=https://discord.gg/REPLACE_ME
