# Copy to backend/.env.production or a private service env file. Never commit real values.
NODE_ENV=production
PORT=48787
APP_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
OWNER_USER_ID=owner_prod
# Supply an owner entry with an argon2id passwordHash; do not put a password here.
WEB_LOGIN_USERS_JSON=[]
CORS_ORIGINS=https://tower.example.com
TRUST_PROXY=1
REGISTRATION_MODE=invite_only
REGISTRATION_DEFAULT_ROLE=pilot
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=ksc_tower
MARIADB_PASSWORD=CHANGE_ME
MARIADB_DATABASE=ksc_tower
REDIS_URL=redis://127.0.0.1:6379
DEV_OPEN_AUTH=false
DEV_DEFAULT_WEB_USER=false
DEV_IN_MEMORY=false
