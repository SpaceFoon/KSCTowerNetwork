# --- Web frontend production build env ---
#
# Copy to .env.production (gitignored) before running `npm run build`.
# These values get inlined into the static bundle that you deploy to your CDN.
#
# Required when web and backend live on different origins.
VITE_API_BASE=https://api.tower.example.com

# If you single-origin (backend serves the SPA), leave VITE_API_BASE unset.
