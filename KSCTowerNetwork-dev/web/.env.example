# --- Web frontend env (Vite) ---
#
# Copy to .env.development for local dev (gitignored), or to .env.production for
# the build that ships to your hosting (Vercel / Cloudflare Pages / etc.).
#
# Vite only inlines variables prefixed VITE_ into the client bundle.
# Do NOT put real secrets here — these values are visible in the browser.

# Absolute base for backend API calls. Leave empty for dev (uses Vite proxy
# in vite.config.ts) or for single-origin production (backend serves the SPA).
# For split deployments (web on a CDN, backend on its own host) set this to
# the public backend URL, e.g.:
#   VITE_API_BASE=https://api.tower.example.com
VITE_API_BASE=

# Quick-fill presets shown in the LoginPage dev dropdown. Must be valid JSON
# (single line). Keep in sync with WEB_LOGIN_USERS_JSON in backend/.env.development.
# Gated on `import.meta.env.DEV` in LoginPage.tsx.
VITE_DEV_LOGIN_PRESETS=[{"id":"admin","label":"Admin (owner)","email":"admin@ksc.local","password":"admin12345"},{"id":"controller","label":"Controller","email":"controller@ksc.local","password":"controller12345"},{"id":"pilot","label":"Pilot","email":"pilot@ksc.local","password":"pilot12345"}]
